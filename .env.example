# Copie este arquivo para ".env.local" e preencha com os valores reais.
# Nada aqui deve conter segredos reais commitados no repositório.

# URL pública do site (usada em metadata, Open Graph e sitemap)
NEXT_PUBLIC_SITE_URL=https://www.plansul.net

# URLs dos sistemas externos (preencher com os endereços oficiais)
#
# ATENÇÃO se for rodar via Docker/Rancher: estas 4 variáveis são usadas no
# Header (que roda no navegador), então o Next.js precisa delas NO MOMENTO
# DO BUILD da imagem, não só em runtime — preencha-as aqui e no .env que o
# docker-compose.yml lê (mesmo arquivo, se você copiar este para ".env" na
# raiz do projeto) ANTES de rodar "docker compose build". Ver README.
NEXT_PUBLIC_PORTAL_BENEFICIARIO_URL=
NEXT_PUBLIC_PORTAL_EMPRESA_URL=
NEXT_PUBLIC_PORTAL_PRESTADOR_URL=
NEXT_PUBLIC_GUIA_MEDICO_URL=

# Endpoint futuro para envio dos formulários (Contato / Ouvidoria)
# Ex.: uma rota de API própria, um serviço de e-mail transacional, ou webhook.
FORM_SUBMIT_ENDPOINT=

# Banco externo de usuários do Portal do Beneficiário (login com e-mail/senha,
# sem cadastro nesta área — ver src/app/api/beneficiario/login/route.ts).
# Ainda não recebido; a Plansul vai passar o caminho/credenciais de conexão
# separadamente. Enquanto estiver vazio, a rota de login responde
# "serviço indisponível" em vez de inventar uma autenticação falsa.
BENEFICIARIO_DB_URL=

# Credenciais de envio de e-mail (SMTP) — preencher apenas no ambiente de produção,
# nunca commitar valores reais neste arquivo.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Chave de API de mapas, se for usado um serviço de mapa incorporado (ex. Google Maps)
NEXT_PUBLIC_MAPS_API_KEY=
