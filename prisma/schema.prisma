// Banco de dados do site institucional.
//
// Escopo intencional: aqui ficam apenas conteúdos que a Plansul PUBLICA no
// próprio site (documentos, unidades, equipe, textos institucionais).
// Beneficiário, Rede Credenciada e Portal do Cliente continuam apontando
// para os sistemas externos já existentes (ver EXTERNAL_LINKS em
// src/lib/constants.ts) — este banco não duplica esses dados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Documentos regulatórios publicados por ano — hoje usado para as listas de
/// IDSS e Reajuste de Contratos Coletivos, mas serve para qualquer categoria
/// futura do mesmo formato (um PDF por ano).
model Documento {
  id           String   @id @default(cuid())
  categoria    String   // "idss" | "reajuste-coletivo"
  ano          Int
  titulo       String
  descricao    String?
  // Caminho público do PDF (ex: "/documentos/idss/idss-2024.pdf").
  // Fica null enquanto o arquivo oficial ainda não foi recebido — o
  // front-end mostra "PDF em breve" nesse caso, nunca inventa um link.
  arquivoUrl   String?
  ordem        Int      @default(0)
  publicadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([categoria, ano])
  @@index([categoria])
}

/// Unidades físicas de atendimento.
model Unidade {
  id       String @id @default(cuid())
  slug     String @unique
  cidade   String
  estado   String
  endereco String
  telefone String
  ordem    Int    @default(0)
}

/// Equipe / liderança institucional (página "Nossa equipe").
model MembroEquipe {
  id         String  @id @default(cuid())
  nome       String
  cargo      String
  depoimento String
  fotoUrl    String?
  ordem      Int     @default(0)
}

/// Blocos de texto institucional editáveis sem precisar mexer no código
/// (ex.: "historia" = texto da página Nossa História).
model ConteudoTexto {
  id           String   @id @default(cuid())
  slug         String   @unique
  titulo       String
  corpo        String
  atualizadoEm DateTime @updatedAt
}

/// Mensagens enviadas pelos formulários do site (Contato, Ouvidoria,
/// Trabalhe Conosco, "quero saber mais" dos planos, etc.) — ver
/// src/components/Contact e src/app/api/manifestacoes/route.ts.
/// "categoria" identifica de qual formulário veio (ex.: "ouvidoria").
model Manifestacao {
  id        String   @id @default(cuid())
  categoria String
  nome      String
  email     String
  telefone  String?
  mensagem  String
  criadoEm  DateTime @default(now())

  @@index([categoria])
}
